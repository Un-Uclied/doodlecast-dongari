; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="DOODLECAST"
config/description="DOODLECAST : 마법진을 그려 공격하고 적을 피하며 마왕성의 던전을 클리어 하세요."
config/version="1.1.2"
run/main_scene="res://scenes/ui/main_menu.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
boot_splash/show_image=false
boot_splash/stretch_mode=0
boot_splash/use_filter=false
boot_splash/image="uid://cj4lhrswiind8"
config/icon="uid://cj4lhrswiind8"

[autoload]

GameRun="*res://scripts/autoload/game_run.gd"
Music="*res://scripts/autoload/music.gd"
SceneTransition="*res://scenes/ui/transitions/scene_transition.tscn"
Leaderboard="*res://scripts/autoload/leaderboard.gd"

[display]

window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[dotnet]

project/assembly_name="DOODLECAST"

