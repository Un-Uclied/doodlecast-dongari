[sub_resource type="Shader" id="Shader_remove_baked_shadow"]
code = "shader_type canvas_item;

void fragment() {
	// The soldier sheet uses this color only for its baked ground shadow.
	vec3 baked_shadow = vec3(83.0, 69.0, 69.0) / 255.0;
	COLOR.a *= step(0.001, distance(texture(TEXTURE, UV).rgb, baked_shadow));
}
"

